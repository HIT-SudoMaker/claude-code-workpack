{
  "name": "ccw-workspace",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/ccw"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test --test-timeout=120000 packages/ccw/test/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "start": "node packages/ccw/dist/main.js",
    "package:runtime": "npm run build && node scripts/package-runtime.mjs",
    "test:runtime": "node --test scripts/package-runtime.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
